# Public site origin (required behind TLS / reverse proxy)
EMDASH_SITE_URL=https://example.com

# Node server bind (production)
HOST=0.0.0.0
PORT=4321

# Encrypts plugin/admin secrets (SMTP password if saved in admin, etc.)
# Generate: pnpm exec emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# Persistent volume paths (DevOps mounts)
# Local defaults: ./data.db and ./uploads
DATABASE_PATH=/data/emdash.db
UPLOADS_DIR=/data/uploads

# Google OAuth (admin login)
# Redirect URI: https://<public-host>/_emdash/api/auth/oauth/google/callback
EMDASH_OAUTH_GOOGLE_CLIENT_ID=
EMDASH_OAUTH_GOOGLE_CLIENT_SECRET=

# SMTP (magic links, invites, recovery)
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# tls (port 465) or starttls (default for other ports)
EMAIL_SMTP_SECURE=starttls
EMAIL_SMTP_FROM="Adxens <noreply@example.com>"
# Or set these instead of EMAIL_SMTP_FROM:
# EMAIL_SMTP_FROM_NAME=Adxens
# EMAIL_SMTP_FROM_EMAIL=noreply@example.com
# EMAIL_SMTP_REPLY_TO=hello@example.com
