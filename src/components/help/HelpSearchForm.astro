---
import type { ContentEntry } from "emdash";
import type { HelpArticleData, HelpTopicData } from "../../lib/help";
import HelpCommandPalette from "./HelpCommandPalette.astro";

interface TopicGroup {
	topic: ContentEntry<HelpTopicData>;
	articles: ContentEntry<HelpArticleData>[];
}

interface Props {
	action?: string;
	query?: string;
	topics?: { slug: string; title: string }[];
	topic?: string;
	compact?: boolean;
	groups?: TopicGroup[];
}

const {
	action = "/help/search",
	query = "",
	topics = [],
	topic = "all",
	compact = false,
	groups = [],
} = Astro.props;
---

{
	compact && topics.length > 0 ? (
		<div class="help-hs">
			<button type="button" class="help-search help-search--cmd" data-help-cmd-open>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle
						cx="11"
						cy="11"
						r="7"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
					/>
					<path
						d="m20 20-3.5-3.5"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
					/>
				</svg>
				<span>{query || "What do you need help with?"}</span>
				<kbd>⌘K</kbd>
			</button>
			<form method="get" action={action} class="help-topic-filter">
				{query && <input type="hidden" name="q" value={query} />}
				<select
					class="help-catsel"
					name="topic"
					aria-label="Filter by category"
					onchange="this.form.submit()"
				>
					<option value="all" selected={topic === "all"}>
						All categories
					</option>
					{topics.map((t) => (
						<option value={t.slug} selected={topic === t.slug}>
							{t.title}
						</option>
					))}
				</select>
			</form>
		</div>
	) : (
		<button type="button" class="help-search help-search--cmd" data-help-cmd-open>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8" />
				<path
					d="m20 20-3.5-3.5"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
				/>
			</svg>
			<span>{query || "What do you need help with?"}</span>
			<span class="help-search__hint">
				<kbd>⌘K</kbd>
			</span>
		</button>
	)
}

<HelpCommandPalette groups={groups} />
