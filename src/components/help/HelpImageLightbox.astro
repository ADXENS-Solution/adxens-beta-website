---
---

<dialog class="help-zoom" data-help-zoom aria-label="Zoomed image">
	<div class="help-zoom__panel">
		<div class="help-zoom__toolbar">
			<span data-help-zoom-label>Image</span>
			<div class="help-zoom__actions">
				<button type="button" class="help-zoom__btn" data-help-zoom-out aria-label="Zoom out">
					−
				</button>
				<button type="button" class="help-zoom__btn" data-help-zoom-in aria-label="Zoom in">
					+
				</button>
				<button type="button" class="help-zoom__btn" data-help-zoom-reset aria-label="Reset zoom">
					1×
				</button>
				<button type="button" class="help-zoom__btn" data-help-zoom-close aria-label="Close">
					×
				</button>
			</div>
		</div>
		<div class="help-zoom__stage" data-help-zoom-stage>
			<img class="help-zoom__img" alt="" data-help-zoom-img />
			<div class="help-zoom__hint">Scroll to zoom · drag to pan · Esc to close</div>
		</div>
	</div>
</dialog>

<script>
	declare global {
		interface Window {
			__helpZoomBound?: boolean;
		}
	}

	function getZoomParts() {
		const dialog = document.querySelector<HTMLDialogElement>("[data-help-zoom]");
		if (!dialog) return null;
		const stage = dialog.querySelector<HTMLElement>("[data-help-zoom-stage]");
		const img = dialog.querySelector<HTMLImageElement>("[data-help-zoom-img]");
		const label = dialog.querySelector<HTMLElement>("[data-help-zoom-label]");
		if (!stage || !img) return null;
		return { dialog, stage, img, label };
	}

	let scale = 1;
	let tx = 0;
	let ty = 0;
	let dragging = false;
	let lastX = 0;
	let lastY = 0;

	const apply = () => {
		const parts = getZoomParts();
		if (!parts) return;
		parts.img.style.transform = `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(${scale})`;
	};

	const fit = () => {
		const parts = getZoomParts();
		if (!parts) return;
		const naturalW = parts.img.naturalWidth || 1;
		const naturalH = parts.img.naturalHeight || 1;
		const pad = 32;
		const maxW = Math.max(120, parts.stage.clientWidth - pad);
		const maxH = Math.max(120, parts.stage.clientHeight - pad);
		const fitScale = Math.min(1, maxW / naturalW, maxH / naturalH);
		scale = Math.max(0.2, fitScale);
		tx = 0;
		ty = 0;
		parts.img.style.width = `${naturalW}px`;
		parts.img.style.height = `${naturalH}px`;
		apply();
	};

	const setZoom = (next: number, originX?: number, originY?: number) => {
		const parts = getZoomParts();
		if (!parts) return;
		const prev = scale;
		const clamped = Math.min(5, Math.max(0.4, next));
		if (originX != null && originY != null) {
			const rect = parts.stage.getBoundingClientRect();
			const cx = originX - rect.left - rect.width / 2;
			const cy = originY - rect.top - rect.height / 2;
			tx = cx - ((cx - tx) * clamped) / prev;
			ty = cy - ((cy - ty) * clamped) / prev;
		}
		scale = clamped;
		apply();
	};

	const openZoom = (source: HTMLImageElement) => {
		const parts = getZoomParts();
		if (!parts) return;
		const src = source.currentSrc || source.src;
		if (!src) return;
		parts.img.src = src;
		parts.img.alt = source.alt || "Help article image";
		if (parts.label) parts.label.textContent = source.alt?.trim() || "Image";
		if (!parts.dialog.open) parts.dialog.showModal();
		const ready = () => fit();
		if (parts.img.complete && parts.img.naturalWidth) ready();
		else parts.img.onload = ready;
	};

	const closeZoom = () => {
		const parts = getZoomParts();
		if (parts?.dialog.open) parts.dialog.close();
	};

	function bindHelpImageLightbox() {
		const parts = getZoomParts();
		if (!parts || !document.querySelector(".help-body")) return;
		if (parts.dialog.dataset.bound === "1") return;
		parts.dialog.dataset.bound = "1";

		parts.dialog.querySelector("[data-help-zoom-close]")?.addEventListener("click", closeZoom);
		parts.dialog
			.querySelector("[data-help-zoom-in]")
			?.addEventListener("click", () => setZoom(scale * 1.2));
		parts.dialog
			.querySelector("[data-help-zoom-out]")
			?.addEventListener("click", () => setZoom(scale / 1.2));
		parts.dialog.querySelector("[data-help-zoom-reset]")?.addEventListener("click", fit);

		parts.dialog.addEventListener("click", (event) => {
			if (event.target === parts.dialog) closeZoom();
		});

		parts.stage.addEventListener(
			"wheel",
			(event) => {
				event.preventDefault();
				const delta = event.deltaY > 0 ? 1 / 1.12 : 1.12;
				setZoom(scale * delta, event.clientX, event.clientY);
			},
			{ passive: false },
		);

		parts.stage.addEventListener("pointerdown", (event) => {
			dragging = true;
			lastX = event.clientX;
			lastY = event.clientY;
			parts.stage.classList.add("is-dragging");
			parts.stage.setPointerCapture(event.pointerId);
		});

		parts.stage.addEventListener("pointermove", (event) => {
			if (!dragging) return;
			tx += event.clientX - lastX;
			ty += event.clientY - lastY;
			lastX = event.clientX;
			lastY = event.clientY;
			apply();
		});

		const endDrag = (event: PointerEvent) => {
			dragging = false;
			parts.stage.classList.remove("is-dragging");
			if (parts.stage.hasPointerCapture(event.pointerId)) {
				parts.stage.releasePointerCapture(event.pointerId);
			}
		};

		parts.stage.addEventListener("pointerup", endDrag);
		parts.stage.addEventListener("pointercancel", endDrag);
	}

	if (!window.__helpZoomBound) {
		window.__helpZoomBound = true;

		document.addEventListener("click", (event) => {
			const target = event.target as HTMLElement | null;
			const source = target?.closest?.(".help-body .emdash-image img") as
				| HTMLImageElement
				| null;
			if (!source) return;
			event.preventDefault();
			event.stopPropagation();
			openZoom(source);
		});
	}

	bindHelpImageLightbox();
	document.addEventListener("astro:page-load", bindHelpImageLightbox);
</script>
