---
import type { ContentEntry } from "emdash";
import type { HelpArticleData, HelpTopicData } from "../../lib/help";
import { articlePath } from "../../lib/help";

interface TopicGroup {
	topic: ContentEntry<HelpTopicData>;
	articles: ContentEntry<HelpArticleData>[];
}

interface Props {
	groups: TopicGroup[];
	activeTopicSlug?: string;
	activeArticleSlug?: string;
}

const { groups, activeTopicSlug = "", activeArticleSlug = "" } = Astro.props;
---

<aside class="help-docs__nav help-rail" aria-label="Help navigation" data-help-suggest>
	<div class="help-rail__search">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
			<path
				d="m20 20-3.5-3.5"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"></path>
		</svg>
		<input
			type="search"
			placeholder="Search articles…"
			aria-label="Search help articles"
			aria-autocomplete="list"
			aria-controls="help-rail-suggest"
			autocomplete="off"
			data-help-suggest-input
		/>
	</div>
	<ul
		class="help-suggest help-rail__suggest"
		id="help-rail-suggest"
		role="listbox"
		hidden
		data-help-suggest-list
	>
	</ul>

	<div class="help-rail__h">Topics</div>
	<nav class="help-acc" aria-label="Topics">
		{
			groups.map((group) => {
				const open = group.topic.id === activeTopicSlug;
				return (
					<details class="help-acc__item" open={open || undefined}>
						<summary>
							<span>{group.topic.data.title}</span>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path
									d="m6 9 6 6 6-6"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</summary>
						<ul>
							{group.articles.map((article) => (
								<li>
									<a
										href={articlePath(article.id)}
										class:list={{ on: article.id === activeArticleSlug }}
										aria-current={
											article.id === activeArticleSlug ? "page" : undefined
										}
									>
										{article.data.title}
									</a>
								</li>
							))}
						</ul>
					</details>
				);
			})
		}
	</nav>
</aside>

<script>
	type SuggestItem = {
		collection?: string;
		id?: string;
		slug?: string | null;
		title?: string;
	};

	function initHelpSuggest(root: HTMLElement) {
		const input = root.querySelector<HTMLInputElement>("[data-help-suggest-input]");
		const list = root.querySelector<HTMLUListElement>("[data-help-suggest-list]");
		if (!input || !list) return;

		let timer = 0;
		let active = -1;
		let items: SuggestItem[] = [];
		let requestId = 0;

		const hide = () => {
			list.hidden = true;
			list.innerHTML = "";
			active = -1;
			items = [];
			input.removeAttribute("aria-activedescendant");
		};

		const render = () => {
			if (!items.length) {
				hide();
				return;
			}
			list.innerHTML = items
				.map((item, index) => {
					const slug = item.slug || item.id || "";
					const title = item.title || slug;
					const href = `/help/${encodeURIComponent(slug)}`;
					return `<li role="option" id="help-suggest-${index}" class="help-suggest__item${
						index === active ? " is-active" : ""
					}" data-index="${index}">
						<a href="${href}">${escapeHtml(title)}</a>
					</li>`;
				})
				.join("");
			list.hidden = false;
		};

		const setActive = (index: number) => {
			active = index;
			[...list.querySelectorAll(".help-suggest__item")].forEach((el, i) => {
				el.classList.toggle("is-active", i === active);
			});
			if (active >= 0) input.setAttribute("aria-activedescendant", `help-suggest-${active}`);
			else input.removeAttribute("aria-activedescendant");
		};

		const fetchSuggestions = async (q: string) => {
			const id = ++requestId;
			try {
				const url = `/_emdash/api/search/suggest?q=${encodeURIComponent(q)}&collections=help_articles&limit=8`;
				const res = await fetch(url);
				if (!res.ok) {
					if (id === requestId) hide();
					return;
				}
				const json = await res.json();
				if (id !== requestId) return;
				const raw = json?.data?.items ?? json?.items ?? [];
				items = Array.isArray(raw)
					? raw.filter(
							(row: SuggestItem) =>
								row?.collection === "help_articles" &&
								typeof (row.slug || row.id) === "string" &&
								typeof row.title === "string",
						)
					: [];
				active = -1;
				render();
			} catch {
				if (id === requestId) hide();
			}
		};

		input.addEventListener("input", () => {
			const q = input.value.trim();
			window.clearTimeout(timer);
			if (q.length < 2) {
				hide();
				return;
			}
			timer = window.setTimeout(() => fetchSuggestions(q), 180);
		});

		input.addEventListener("keydown", (event) => {
			if (event.key === "Enter" && active < 0 && input.value.trim()) {
				event.preventDefault();
				window.location.href = `/help/search?q=${encodeURIComponent(input.value.trim())}`;
				return;
			}
			if (list.hidden || !items.length) return;
			if (event.key === "ArrowDown") {
				event.preventDefault();
				setActive(active < items.length - 1 ? active + 1 : 0);
			} else if (event.key === "ArrowUp") {
				event.preventDefault();
				setActive(active > 0 ? active - 1 : items.length - 1);
			} else if (event.key === "Enter" && active >= 0) {
				event.preventDefault();
				list
					.querySelector<HTMLAnchorElement>(`.help-suggest__item[data-index="${active}"] a`)
					?.click();
			} else if (event.key === "Escape") {
				hide();
			}
		});

		list.addEventListener("mousedown", (event) => {
			const target = event.target as HTMLElement | null;
			if (target?.closest?.(".help-suggest__item")) event.preventDefault();
		});

		input.addEventListener("blur", () => {
			window.setTimeout(hide, 120);
		});
	}

	function escapeHtml(text: string) {
		return text
			.replaceAll("&", "&amp;")
			.replaceAll("<", "&lt;")
			.replaceAll(">", "&gt;")
			.replaceAll('"', "&quot;")
			.replaceAll("'", "&#39;");
	}

	function boot() {
		document.querySelectorAll<HTMLElement>(".help-rail[data-help-suggest]").forEach(initHelpSuggest);
	}

	boot();
	document.addEventListener("astro:page-load", boot);
</script>
