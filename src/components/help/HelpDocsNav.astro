---
import type { ContentEntry } from "emdash";
import type { HelpArticleData, HelpTopicData } from "../../lib/help";
import { articlePath } from "../../lib/help";
import HelpCommandPalette from "./HelpCommandPalette.astro";

interface TopicGroup {
	topic: ContentEntry<HelpTopicData>;
	articles: ContentEntry<HelpArticleData>[];
}

interface Props {
	groups: TopicGroup[];
	activeTopicSlug?: string;
	activeArticleSlug?: string;
}

const { groups, activeTopicSlug = "", activeArticleSlug = "" } = Astro.props;
---

<aside class="help-docs__nav help-rail" aria-label="Help navigation">
	<button type="button" class="help-rail__search" data-help-cmd-open>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
			<path
				d="m20 20-3.5-3.5"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"></path>
		</svg>
		<span>Search articles…</span>
		<kbd>⌘K</kbd>
	</button>

	<div class="help-rail__h">Topics</div>
	<nav class="help-acc" aria-label="Topics">
		{
			groups.map((group) => {
				const open = group.topic.id === activeTopicSlug;
				return (
					<details class="help-acc__item" open={open || undefined}>
						<summary>
							<span>{group.topic.data.title}</span>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path
									d="m6 9 6 6 6-6"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</summary>
						<ul>
							{group.articles.map((article) => (
								<li>
									<a
										href={articlePath(article.id)}
										class:list={{ on: article.id === activeArticleSlug }}
										aria-current={
											article.id === activeArticleSlug ? "page" : undefined
										}
									>
										{article.data.title}
									</a>
								</li>
							))}
						</ul>
					</details>
				);
			})
		}
	</nav>
</aside>

<HelpCommandPalette groups={groups} />
