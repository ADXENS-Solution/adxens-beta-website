---
import { Font } from "astro:assets";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import {
	DEFAULT_SITE_TITLE,
	absoluteUrl,
	resolveSiteOrigin,
} from "../lib/seo";
import "../styles/legal.css";

interface Props {
	title: string;
	fullTitle?: string;
	description?: string | null;
	canonical?: string | null;
	robots?: string | null;
	jsonLd?: string;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	fullTitle = `${title} — Adxens`,
	description,
	canonical: canonicalProp,
	robots,
	jsonLd,
	content,
} = Astro.props;

const origin = resolveSiteOrigin(Astro.site ?? Astro.url);
const path = content?.slug ? `/${content.slug}` : Astro.url.pathname;
const canonical = canonicalProp ?? absoluteUrl(path, origin);
const ogImage = absoluteUrl("/adxens-logo.png", origin);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title,
	description,
	canonical,
	image: ogImage,
	content,
	siteName: DEFAULT_SITE_TITLE,
	siteUrl: origin,
	seo: {
		robots: robots ?? "index, follow",
		ogImage,
		ogTitle: fullTitle,
		ogDescription: description,
	},
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="application-name" content="Adxens" />
		<meta property="og:locale" content="en_US" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
		<Font cssVariable="--font-inter" preload />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
		<style is:global>
			:root {
				--font-inter-face: var(--font-inter), Inter, "Inter Fallback", Inter, system-ui, sans-serif;
				--font-weight-regular: 400;
				--font-weight-semibold: 600;
			}
			html,
			body {
				margin: 0;
				min-height: 100%;
				font-family: Arial, Helvetica, sans-serif;
				font-weight: 400;
			}
			.legal-root,
			.legal-root button,
			.legal-portable {
				font-family: var(--font-inter-face);
				font-weight: 400; /* Inter Regular */
			}
			.legal-root h1,
			.legal-root h2,
			.legal-root h3 {
				font-family: var(--font-inter-face);
				font-weight: 600; /* Inter Semi Bold */
			}
		</style>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<div class="legal-root">
			<script is:inline>
				(function () {
					try {
						var m = document.cookie.match(
							/(?:^|; )adxens-legal-theme=(dark|light)(?:;|$)/,
						);
						if (m && document.currentScript && document.currentScript.parentElement) {
							document.currentScript.parentElement.setAttribute("data-theme", m[1]);
						}
					} catch (e) {}
				})();
			</script>
			<slot />
		</div>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
